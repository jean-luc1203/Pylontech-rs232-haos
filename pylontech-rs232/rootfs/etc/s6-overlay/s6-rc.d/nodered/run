#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Pylontech RS232 add-on
# Starts Node-RED
# ==============================================================================
export NODE_PATH=/opt/node_modules
PYLONTECH_RS232_INSTALL_ID="$(tr -d '\n\r' < /data/pylontech_rs232_install_id)"
export PYLONTECH_RS232_INSTALL_ID
export SMARTPHOTON_INSTALL_ID="${PYLONTECH_RS232_INSTALL_ID}"

cd /opt || bashio::exit.nok "Could not change directory to Node-RED"

bashio::log.info "Starting Node-RED on port 1893..."

exec npm start -- --settings /etc/node-red/settings.js
